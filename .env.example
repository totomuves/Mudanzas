# Copia este archivo como .env.local y completa los valores.

# Nombre que se muestra en la app
NEXT_PUBLIC_APP_NAME="MÜVEO"
# URL pública de la app (en local: http://localhost:3000; en Vercel: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública "publishable" (sb_publishable_...) o la antigua "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clave secreta "secret" (sb_secret_...) o la antigua "service_role". ¡Nunca la expongas en el navegador!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Ingreso con Google (opcional) ---
# Ponlo en 1 solo después de activar Google en Supabase (pasos en el README). Si no, el botón no aparece.
NEXT_PUBLIC_GOOGLE_AUTH=

# --- Mercado Pago (Tus integraciones -> Credenciales de prueba) ---
# Access token de PRUEBA para desarrollo (APP_USR-... de una cuenta de prueba vendedora)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones -> Webhooks). Opcional en local.
MP_WEBHOOK_SECRET=

# --- IA para fotos y productos (opcional) ---
# Sugerir título, descripción, categoría y precio desde la foto (Claude).
# Créala en https://platform.claude.com -> API Keys. Sin ella, el botón no aparece.
ANTHROPIC_API_KEY=
# Quitar fondo con remove.bg en vez de la IA gratuita del navegador (opcional).
# https://www.remove.bg/api -> 50 fotos gratis al mes en baja resolución, luego pagado.
REMOVE_BG_API_KEY=

# --- Recomendador: "huellas" para saber qué productos se parecen (opcional) ---
# Sin ninguna de estas claves funciona igual con una versión local por palabras (gratis).
# Recomendado: Google Gemini, tiene nivel gratuito -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternativas: OpenAI (text-embedding-3-small, muy barato) o Jina CLIP (entiende también la foto)
OPENAI_API_KEY=
JINA_API_KEY=
# Forzar uno: gemini | openai | jina | local (si no, se elige según la clave que exista)
EMBEDDINGS_PROVIDER=

# --- Avisos al teléfono (Web Push, opcional) ---
# Sin estas claves los avisos igual aparecen en la campana de la app.
# Generarlas una vez con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@tu-dominio.cl
