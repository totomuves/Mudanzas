# Copia este archivo como .env.local y completa los valores.

# Nombre que se muestra en la app
NEXT_PUBLIC_APP_NAME="Totomuves"
# URL pública de la app (en local: http://localhost:3000; en Vercel: https://tu-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública "publishable" (sb_publishable_...) o la antigua "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clave secreta "secret" (sb_secret_...) o la antigua "service_role". ¡Nunca la expongas en el navegador!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Mercado Pago (Tus integraciones -> Credenciales de prueba) ---
# Access token de PRUEBA para desarrollo (APP_USR-... de una cuenta de prueba vendedora)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de webhooks (Tus integraciones -> Webhooks). Opcional en local.
MP_WEBHOOK_SECRET=
